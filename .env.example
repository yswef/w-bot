# ════════════════════════════════════════════════════════════
#  إعدادات بوت أستا  |  Asta Bot configuration
#  انسخ هذا الملف باسم .env ثم عدّل القيم
#  Copy this file to .env and edit the values
# ════════════════════════════════════════════════════════════

# ── الأوامر / Commands ──────────────────────────────────────
# بادئة الأوامر (مثال: .انمي)  |  Command prefix (e.g. .انمي)
COMMAND_PREFIX=.

# ── الصلاحيات / Permissions ─────────────────────────────────
# رقمك بصيغة دولية بدون +  |  Your number, international format, no +
OWNER_NUMBER=967784609423

# أرقام مالكين إضافية مفصولة بفاصلة  |  Extra owner numbers, comma-separated
EXTRA_OWNER_NUMBERS=967784773314,967784609423

# رقم الأدمن الثاني  |  Second admin number
SECOND_ADMIN_NUMBER=967735076371

# ── لوحة التحكم / Dashboard ─────────────────────────────────
# رمز الدخول للوحة التحكم. اتركه فارغاً ليُولَّد عشوائياً عند كل تشغيل
# (ستجده مطبوعاً في سجل التشغيل، أو أرسل أمر .لوحة من واتساب)
# Dashboard access token. Leave empty for a random one each run
# (printed in the startup log; or send the .لوحة command on WhatsApp)
DASHBOARD_TOKEN=

# منفذ لوحة التحكم  |  Dashboard port
PORT=3000

# الرابط العام للوحة عند النشر على استضافة  |  Public dashboard URL when deployed
# DASHBOARD_PUBLIC_URL=https://your-app.up.railway.app

# تعطيل لوحة التحكم كلياً  |  Disable the dashboard entirely
ENABLE_DASHBOARD=true

# ── الملصقات / Stickers ─────────────────────────────────────
STICKER_PACK_NAME="استا ساما هو الافضل"
STICKER_AUTHOR_NAME="ENG.YOUSEF"

# ── الميزات / Feature flags (true / false) ──────────────────
ENABLE_AUTO_REPLY=true
ENABLE_ANTI_DELETE=true
ENABLE_STICKER_MAKER=true
ENABLE_SCHEDULER=true
# تنفيذ الأوامر المرسلة من رقم البوت نفسه
# Execute commands sent from the bot's own number
ENABLE_SELF_EXECUTION=true

# ── الجلسات / Sessions ──────────────────────────────────────
# أسماء الجلسات مفصولة بفاصلة (لتشغيل أكثر من رقم)
# Session names, comma-separated (to run multiple numbers)
SESSION_NAMES=default
# مجلد حفظ الجلسات (اربطه بقرص دائم عند النشر)
# Session storage folder (mount a persistent volume when deploying)
# SESSION_BASE_DIR=/data/session

# ── عام / General ───────────────────────────────────────────
# المنطقة الزمنية للمهام المجدولة  |  Timezone for scheduled tasks
TIMEZONE=Asia/Riyadh

# بيانات المطوّر  |  Developer contact
DEVELOPER_CONTACT=967784609423
DEVELOPER_WEBSITE=https://engyusef.alpha-code.net
