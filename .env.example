# ============================================================
#  أستا ساما — ملف الإعدادات / Asta Sama — configuration
#  انسخ هذا الملف باسم .env وعدّل القيم
#  Copy this file to .env and edit the values
# ============================================================

# ---------- أوامر / Commands ----------
# بادئة الأوامر (مثال: .سعر أو !سعر) / Command prefix
COMMAND_PREFIX=.

# ---------- الصلاحيات / Permissions ----------
# رقمك أنت (بصيغة دولية بدون +) — يعطيك صلاحيات المالك
# Your number (international format, no +) — grants owner powers
OWNER_NUMBER=967784609423

# رقم الأدمن الثاني / Second admin number
SECOND_ADMIN_NUMBER=967735076371

# أرقام مالكين إضافيين مفصولة بفاصلة / Extra owner numbers, comma separated
EXTRA_OWNER_NUMBERS=967784773314,967784609423

# ---------- الملصقات / Stickers ----------
STICKER_PACK_NAME="استا ساما هو الافضل"
STICKER_AUTHOR_NAME="ENG.YOUSEF"

# ---------- الميزات / Features (true / false) ----------
# الردود الآلية / auto replies
ENABLE_AUTO_REPLY=true
# كشف الرسائل المحذوفة / anti-delete
ENABLE_ANTI_DELETE=true
# صناعة الملصقات / sticker maker
ENABLE_STICKER_MAKER=true
# الجدولة والنشرات / scheduler
ENABLE_SCHEDULER=true
# تنفيذ الأوامر من رقمك أنت مباشرة / run commands from your own number
ENABLE_SELF_EXECUTION=true

# ---------- لوحة التحكم / Dashboard ----------
# true = تعمل مع البوت (افتراضي)، false = لا تُشغَّل أبداً
# true = runs with the bot (default), false = never start it
ENABLE_DASHBOARD=true

# 🔑 مهم جداً: التوكن يحمي اللوحة. بدونه أي شخص يعرف الرابط يستطيع التحكم!
# IMPORTANT: the token protects the dashboard. Without it anyone with the link rules your bot!
#   افتح اللوحة بهذا الشكل / open the dashboard like this:
#   https://رابط-اللوحة/?token=اسر_خاص_جداً
DASHBOARD_TOKEN=change-me-to-a-long-secret

# المنفذ — اتركه فارغاً على Railway/Render لأنه يحدد PORT تلقائياً
# Port — leave it empty on Railway/Render (PORT is injected automatically)
# DASHBOARD_PORT=3000

# الرابط العام للوحة (اختياري). إن تُرك فارغاً يُقرأ من RAILWAY_PUBLIC_DOMAIN
# Public dashboard URL (optional). If empty it is read from RAILWAY_PUBLIC_DOMAIN
# DASHBOARD_PUBLIC_URL=https://your-app.up.railway.app

# عدد الرسائل في صفحة اللوحة / how many messages to show
DASHBOARD_RECENT_LIMIT=50


# ---------- الجلسات / Sessions ----------
# أسماء الجلسات مفصولة بفاصلة (لكل جلسة مجلد خاص) / session names, comma separated
SESSION_NAMES=default
# (قديم/مقبول أيضاً: SESSION_NAME و SESSION_DIR لنفس الغرض)

# متغيرات تُحقنها Railway تلقائياً — لا تضبطها أنت، لكن الكود يقرأها:
# injected by Railway automatically (read by the code, never set them yourself):
#   PORT, RAILWAY_PUBLIC_DOMAIN, RAILWAY_STATIC_URL, RAILWAY_VOLUME_MOUNT_PATH

# أين تُحفظ الجلسة وقاعدة البيانات والوسائط.
# Where sessions, the SQLite file and media are stored.
# ✅ على Railway لست بحاجة لأي منها: إذا ركّبت Volume فالبوت يقرأ
#    RAILWAY_VOLUME_MOUNT_PATH تلقائياً ويضع الثلاثة داخله.
# On Railway you don't need these: attach a Volume and the bot puts all three
#    inside it automatically (read from RAILWAY_VOLUME_MOUNT_PATH).
# هذه المتغيرات للتجاوز اليدوي فقط (لها الأولوية):
# These are manual overrides only (they win over auto-detection):
# SESSION_BASE_DIR=/app/data/session
# DB_PATH=/app/data/bot.db
# MEDIA_STORE_DIR=/app/data/media_store

# ---------- أخرى / Misc ----------
# منطقة زمنية للفعاليات والتذكيرات المجدولة / timezone for schedules & reminders
TIMEZONE=Asia/Riyadh

# بيانات المطور (تظهر في أمر تواصل) / developer info shown by .تواصل
DEVELOPER_CONTACT=967784609423
DEVELOPER_WEBSITE=https://engyusef.alpha-code.net

# مستوى السجلات: fatal|error|warn|info|debug / log level
LOG_LEVEL=info
