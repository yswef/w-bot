# انسخ هذا الملف باسم .env وعدّل القيم

# بادئة الأوامر (مثال: !سعر أو /سعر)
COMMAND_PREFIX=!

# اسم صاحب البوت اللي يظهر في الملصقات
STICKER_PACK_NAME=My Bot Stickers
STICKER_AUTHOR_NAME=YourName

# رقمك أنت (بصيغة دولية بدون +) عشان البوت يتجاهل رسائلك أو يعطيك صلاحيات أدمن
OWNER_NUMBER=9665XXXXXXXX

# فعّل أو عطّل ميزات كاملة (true / false)
ENABLE_AUTO_REPLY=true
ENABLE_ANTI_DELETE=true
ENABLE_STICKER_MAKER=true
ENABLE_SCHEDULER=true

# منطقة زمنية للفعاليات المجدولة
TIMEZONE=Asia/Riyadh
